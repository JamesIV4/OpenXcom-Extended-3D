# Reference files
/reference

# Local decoded reference output (the generators in art/tools stay tracked)
/art/reference/**
!/art/reference/**/
!/art/reference/**/*.py
!/art/reference/**/*.ps1
!/art/reference/**/*.sh
!/art/reference/**/*.bat

# Artwork experiments, review renders, and temporary exports.
# Canonical editable sources are in art/source; runtime art is in the main
# Godot project's assets directory. Keep helper code in every art directory.
/art/**/*.png
/art/**/*.jpg
/art/**/*.jpeg
/art/**/*.webp
/art/**/*.exr
/art/**/*.hdr
/art/**/*.tga
/art/**/*.tif
/art/**/*.tiff
/art/**/*.gif
/art/**/*.mp4
/art/**/*.npy
/art/**/*.npz
/art/**/*.blend
/art/**/*.gltf
/art/**/*.glb
/art/**/*.bin
/art/**/*.import
!/art/source/**/*.blend
!/art/team/**/editable/**/*.blend
# Authored texture required by the editable human source/export helper.
!/art/team/units_opus55/textures/v01/hair_male_cards_basecolor.png
# Downloaded texture libraries are local inputs, not finished artwork.
/art/source/cc0_library/**
!/art/source/cc0_library/**/
!/art/source/cc0_library/**/*.py
!/art/source/cc0_library/**/*.ps1
!/art/source/cc0_library/**/*.json

# Generated reports/captures; allow the scripts that produce them.
/art/review/**
!/art/review/**/
!/art/review/**/*.py
!/art/review/**/*.ps1
!/art/review/**/*.gd
!/art/review/**/*.gd.uid
!/art/review/**/*.sh
!/art/review/**/*.bat
/xcom-3d-godot/**/assets/review_diagnostics/
/xcom-3d-godot/labs/**/assets/
/xcom-3d-godot/perf-lab/assets/
/xcom-3d-godot/perf-lab/results/
/xcom-3d-godot/unit-lab/assets/
# Other lab screenshots/exports, without hiding lab code, scenes or shaders.
/xcom-3d-godot/labs/**/*.png
/xcom-3d-godot/labs/**/*.jpg
/xcom-3d-godot/labs/**/*.gltf
/xcom-3d-godot/labs/**/*.glb
/xcom-3d-godot/labs/**/*.bin
/xcom-3d-godot/labs/**/*.blend
/xcom-3d-godot/labs/**/*.import
/xcom-3d-godot/perf-lab/**/*.png
/xcom-3d-godot/unit-lab/**/*.png

# Art build evidence: trial receipts, measurements, scratch exports and captures.
# Match directory contents so code helpers within these trees can be retained.
/art/team/**/diagnostics/**
/art/team/**/trials/**
/art/team/**/trial/**
/art/team/**/texture_trials/**
/art/team/**/working/**
/art/team/**/failed/**
/art/team/**/replaced_drafts/**
/art/team/**/exports/**
/art/team/**/renders/**
/art/team/**/render/**
/art/team/**/captures/**
/art/team/**/scratch/**
/art/team/**/cancelled/**
/art/team/**/manifests/**
/art/team/**/selected_manifests/**
/art/team/**/assembly/**
/art/team/**/assemblies/**
/art/team/**/interface/**
# Generated JSON reports outside the above output directories. Scope these to
# team workspaces; runtime sidecars, catalogs and authored recipes stay visible.
/art/team/**/build_manifest.json
/art/team/**/trial_manifest.json
/art/team/**/metrics.json
/art/team/**/stats.json
/art/team/**/results*.json
/art/team/**/summary.json
/art/team/**/build_summary*.json
/art/team/**/final_build_summary*.json
/art/team/**/build_log.json
/art/team/**/metric_manifest.json
/art/team/**/texture_manifest.json
/art/team/**/review_manifest.json
/art/team/**/render_manifest.json
/art/team/**/sheet_manifest.json
/art/team/**/views.json
/art/team/**/*validation*.json
/art/team/**/*audit*.json
/art/team/**/assembly_report.json
/art/team/**/assembly_manifest.json
/art/team/**/selected_exports.json
/art/team/**/selected_review_sheets.json
/art/team/**/root_gate*.json
/art/team/**/*gates*.json
/art/team/**/pixel_dumps.json
/art/team/**/checkpoint.json
# Keep tool implementations and their documentation, even inside scratch trees.
!/art/team/**/
!/art/team/**/*.py
!/art/team/**/*.ps1
!/art/team/**/*.bat
!/art/team/**/*.sh
!/art/team/**/*.gd
!/art/team/**/*.gd.uid
!/art/team/**/*.gdshader
!/art/team/**/*.gdshaderinc
!/art/team/**/*.tscn
!/art/team/**/project.godot
!/art/team/**/*.md
# Editable sources retain the same exceptions as above.
!/art/team/**/editable/**/*.blend

# Console dumps and capture receipts are generated; prompts/recipes are inputs.
/art/**/*log*.txt
/art/**/stdout*.txt
/art/**/stderr*.txt
/art/**/*_dump.txt
/art/**/*_measure.txt
/xcom-3d-godot/labs/**/*log*.txt
