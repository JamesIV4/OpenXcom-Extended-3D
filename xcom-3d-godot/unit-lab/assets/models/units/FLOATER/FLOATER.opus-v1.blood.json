  "wound_decals": {
    "textures": [
      "wound01",
      "wound02",
      "wound03",
      "wound04"
    ],
    "info": {
      "wound01": {
        "description": "round compact hole, tight spatter ring",
        "hole_center_uv": [
          0.5,
          0.5
        ],
        "streak_dir_uv": null,
        "coverage_alpha_gt_half": 0.082,
        "atlas_quadrant": 0,
        "crop_px_in_atlas": 708
      },
      "wound02": {
        "description": "grazing shot: hole with spatter streaked to +U (image right)",
        "hole_center_uv": [
          0.5,
          0.5
        ],
        "streak_dir_uv": [
          1.0,
          0.12
        ],
        "coverage_alpha_gt_half": 0.064,
        "atlas_quadrant": 1,
        "crop_px_in_atlas": 912
      },
      "wound03": {
        "description": "large torn burst wound, heavy spatter (lethal hits)",
        "hole_center_uv": [
          0.5,
          0.5
        ],
        "streak_dir_uv": null,
        "coverage_alpha_gt_half": 0.215,
        "atlas_quadrant": 2,
        "crop_px_in_atlas": 704
      },
      "wound04": {
        "description": "small puncture, sparse droplets",
        "hole_center_uv": [
          0.5,
          0.5
        ],
        "streak_dir_uv": null,
        "coverage_alpha_gt_half": 0.119,
        "atlas_quadrant": 3,
        "crop_px_in_atlas": 436
      }
    },
    "size_m": {
      "wound01": 0.36,
      "wound02": 0.4,
      "wound03": 0.44,
      "wound04": 0.34
    },
    "projection_depth_m": 0.12,
    "max_per_unit": 6,
    "normal_fade": 0.5,
    "upper_fade": 0.2,
    "lower_fade": 0.2,
    "albedo_mix": 1.0,
    "modulate": "blood colour (per_unit_parameter)",
    "choice": "lethal hit -> wound03; grazing hit (angle between the shot and the inward surface normal > 50 deg) -> wound02 with its +U streak along the shot tangent; otherwise wound01 / wound04 at random",
    "placement": "ray-cast the shot (travel direction) against the unit (the skinned mesh or the ragdoll profile shapes posed on the skeleton) -> hit point, surface normal, bone (largest skin weight at the hit). Decal centre = hit point; projection (decal -Y) = normalize(shot - normal) (half-way between the shot and the inward normal, so grazing hits smear a little without stretching); decal +X = the shot tangent on the surface; parent: a BoneAttachment3D on that bone under the unit Skeleton3D, so the decal follows the body through the hit reaction, the death clip and the ragdoll",
    "cull_mask": "only the unit's own visual layer (VisualInstance3D.layers of its meshes): never the floor or other units (give each unit its own layer, or at least never the floor layer)",
    "stacking": "each hit adds a decal; beyond max_per_unit the oldest is removed",
    "spray": "the hit spray starts on the visible skin at the hit point (nudged 4 mm out along the normal) and flies BACK toward the shooter out of the entry wound: direction = normalize(-shot travel + surface normal), the sidecar spray.runtime cone (user correction 2026-10-02)",
    "source": "wound shapes: Snakeman opus-v1 tint-neutral wound textures (Codex image_gen wound_decals_gen_v1, AI-generated, provenance in art/team/units_opus55/textures/snakeman_v01/gen) upscaled to 512 px with the entry holes added per species; drips shared by hash (blood_runs_gen_v1)",
    "drips": {
      "sets": {
        "drip01": {
          "frames": [
            "drip01_f00_albedo",
            "drip01_f01_albedo",
            "drip01_f02_albedo",
            "drip01_f03_albedo",
            "drip01_f04_albedo",
            "drip01_f05_albedo",
            "drip01_f06_albedo",
            "drip01_f07_albedo"
          ],
          "normal": "drip01_normal",
          "orm": "drip01_orm",
          "coverage_alpha_gt_half_full": 0.344
        },
        "drip02": {
          "frames": [
            "drip02_f00_albedo",
            "drip02_f01_albedo",
            "drip02_f02_albedo",
            "drip02_f03_albedo",
            "drip02_f04_albedo",
            "drip02_f05_albedo",
            "drip02_f06_albedo",
            "drip02_f07_albedo"
          ],
          "normal": "drip02_normal",
          "orm": "drip02_orm",
          "coverage_alpha_gt_half_full": 0.284
        }
      },
      "size_m": [
        0.28,
        0.76
      ],
      "projection_depth_m": 0.14,
      "normal_fade": 0.5,
      "texture_axes": "U across the runs; V down the runs (texture top = the impact point). Godot Decal: U = local +X, V = local +Z, so local +Z = the run direction and the decal centre sits half its length below the hit",
      "direction": "world down at the moment of the hit, projected onto the surface plane at the hit point; frozen in the hit bone frame afterwards (the runs move and fall with the body, they do not re-orient)",
      "skip_if_projected_down_below": 0.25,
      "skip_note": "hits on near-horizontal surfaces (top of the head / shoulders, the underside) get no runs",
      "grow_s": 1.5,
      "grow_ease": "out (fast at first, slowing)",
      "frames": 8,
      "animation": "swap texture_albedo through the reveal frames over grow_s (normal / ORM fixed: Godot masks them with the albedo alpha)",
      "top_offset_m": 0.01,
      "source": "Codex image_gen blood_runs_gen_v1.png (AI-generated, provenance sidecar), masked here"
    },
    "size_note": "Floater 2.35 m: a little larger than the Snakeman set (0.30-0.40 m / 0.26 x 0.70 m) and at least the size of the opus-v1 UV0 chest wound overlay",
    "variants": {
      "wound01": [
        "wound01a",
        "wound01b",
        "wound01c"
      ],
      "wound02": [
        "wound02a",
        "wound02b",
        "wound02c"
      ],
      "wound03": [
        "wound03a",
        "wound03b",
        "wound03c"
      ],
      "wound04": [
        "wound04a",
        "wound04b",
        "wound04c"
      ]
    },
    "random_roll": {
      "enabled": true,
      "except": [
        "wound02"
      ],
      "rule": "per hit pick one hole variant of the chosen wound type at random and roll the decal by a random angle about the surface normal (not the grazing wound02, whose streak follows the shot)"
    },
    "entry_hole": {
      "hole_relative_value": 0.4,
      "blood_value": 0.7059,
      "hole_texture_luminance_srgb": 0.4,
      "hole_result_srgb": "#392046",
      "hole_result_value": 0.2732,
      "hole_value_of_blood_value": 0.387,
      "hole_diameter_of_main_blob": 0.21,
      "res_px": 512,
      "note": "ragged entry hole at the decal centre (= the hit point; the spray root sits on it), user feedback 2026-10-02 (second pass): a DARK SHADE OF THE SPECIES BLOOD COLOUR (~35 % of its value, hue and saturation kept; the darkest part of the wound), ~21.0 % of the main blood blob, graded into the wet ring, roughness .04 in the hole and .06 in a wet zone around it, a shallow normal dimple with a torn lip (s6b_wound_holes.py)"
    }
  }
