        "physical_top_m": 2.34743,
        "visual_level_pitch_m": 2.44949,
        "tile_m": 2.0,
        "hover_note": "the body occupies voxels floatHeight .. floatHeight + standHeight (OXCE TileEngine); hover clips keep the ball bottom at 0.204 m +- the bob; no kneel (routine 1 draws none)"
      },
      "weapon_socket": {
