          "variant_rule": "shot travel direction t in the unit frame (x = unit right, y = unit forward; glTF/Godot: x right, -z forward): t.y <= -0.707 -> Front, t.y >= 0.707 -> Back, else t.x > 0 -> Left, else Right. Play Death<variant>, hand off on its last frame with that variant's velocities. \"Death\" = DeathFront.",
          "extra_push": {
            "bone": "spine_03",
            "bones": [
              "pelvis",
              "spine_02",
              "spine_03",
              "head",
              "upperarm_l",
              "lowerarm_l",
              "hand_l",
              "upperarm_r",
              "lowerarm_r",
              "hand_r",
              "cape_l_01",
              "cape_l_02",
              "cape_c_01",
              "cape_c_02",
              "cape_r_01",
              "cape_r_02"
            ],
            "delta_v_mps_unit_local": [
              0.0,
              0.0,
              0.35
            ],
            "direction": "SHOT TRAVEL DIRECTION: the same delta_v (impulse = delta_v x body mass) on EVERY body in \"bones\" along the horizontal travel direction of the killing shot (root 2026-10-02)"
          },
          "variation": {
            "push_yaw_jitter_deg": 12.0,
            "spin_jitter_radps": 0.35,
            "spin_bone": "spine_03",
            "note": "per death: rotate the push direction about the vertical by a uniform random angle in [-jitter, +jitter] and add a random vertical-axis spin of up to spin_jitter to spin_bone, so corpses differ; 0 disables"
          },
          "ground_clearance_lift_m": 0.002,
          "ground_clearance_rule": "at the hand-off, if any collision shape is below the walking plane, lift all bodies by that depth + 2 mm before releasing them",
          "turn_to_attacker": null,
          "no_turn": "user decision 2026-10-02: no animated turn toward the attacker; the twist turns the body as physics",
          "twist_toward_shooter": {
            "max_delta_angular_velocity_radps": 7.5,
            "bodies": "all (every PhysicalBone3D incl. the machine and the cape plates)",
            "axis": "world up (Godot +Y)",
            "pivot": "mass centre of all bodies at the hand-off (horizontal position)",
            "scale": "angle between the unit facing and the direction to the shooter / 180 deg: 0 front, 0.5 side, 1 behind",
            "sign": "toward the shooter (counter-clockwise seen from above when the shooter is on the unit's left); from directly behind pick the side at random per death",
            "apply": "at the hand-off, after the variant velocities and the push: for EVERY body angular_velocity += up*w; linear_velocity += (up*w) x (body centre - pivot), horizontal",
            "contract": "user / root 2026-10-02: 3x (7.5 rad/s) default; a unit may drop to a per-unit ceiling >= 2x (5.0) only if the Jolt mass-centre gate fails at 3x with the all-body push at 0.6 m/s",
            "intent": "he tries to turn round too late while falling away from the attack (user 2026-10-02)"
          },
          "fall_direction": "away from the shooter (mass centre along the shot travel direction)"
        },
        "settle_and_freeze": {
          "linear_speed_mps": 0.05,
          "angular_speed_radps": 0.25,
          "hold_s": 0.3,
          "time_cap_s": 3.0,
          "assist": {
            "after_s": 1.0,
            "below_mps": 1.0,
            "linear_damp": 2.0,
            "angular_damp": 8.0,
            "rule": "once the fall is over (simulation time >= after_s and every body slower than below_mps), raise the damping of every body to at least these values (Godot DAMP_MODE_REPLACE); Blender tests run without it"
          },
          "assist_late": {
            "after_s": 2.0,
            "below_mps": 0.3,
            "linear_damp": 6.0,
            "angular_damp": 16.0,
            "rule": "shared runtime contract (root 2026-10-02): after the first assist, once every body is slower than below_mps after after_s, raise every body's damping to at least these values"
          },
          "depenetration": {
            "max_lift_m": 0.05,
            "rule": "root 2026-10-02: at freeze, if the deepest skinned vertex is below the walking plane, lift the whole corpse by that depth (capped) - no visible pop"
          },
          "action": "freeze: copy the simulated bone poses into the Skeleton3D pose and stop the simulation"
        },
        "fit": {
          "method": "vertex-cloud fit in bone frames, grown 10 mm",
