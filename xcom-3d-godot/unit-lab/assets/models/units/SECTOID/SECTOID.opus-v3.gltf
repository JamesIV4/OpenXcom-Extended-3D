        "axes": "+Y barrel (along the hand, ahead in the hold), +Z weapon top (up in the IdleArmed / WalkArmed hold: thumb side of the inward-turned grip)"
      },
      "runtime_contract": {
        "clip_names": "looping clips carry a \"-loop\" suffix (Godot imports them as Idle / IdleArmed / Walk / WalkArmed with loop LINEAR); look clips up by both names",
        "armed": "IdleArmed / WalkArmed when the unit holds a one-handed weapon; Attack starts and ends in that hold; attach the weapon to the weapon_r bone (+Y barrel, +Z top)",
        "turn_to_attacker": {
          "when": "during the Hit clip and during the Death lead-in (not a snap on the lethal frame)",
          "duration_s": 0.2,
          "easing": "smoothstep",
          "done_before_handoff": true,
          "note": "the lead-in sits back, so after the turn backward = away from the attacker"
        },
        "death": "play Death (lead-in, 0.4 s) from the current pose while turning to face the attacker; at its last frame start the ragdoll (see ragdoll.handoff: clip velocities, ground-clearance lift, attack-direction push on spine_02 / spine_03 / head, per-death variation); settle-and-freeze; DeathBaked is the no-physics fallback",
        "blood": "hit spray at the exit wound along the shot (blood.spray.runtime), splatter decals at death, pool under the frozen corpse inside the death tile, wound overlay in UV0 (next_pass on a per-unit skin material copy)"
      },
      "albedo_calibration": {
        "method": "opus-v2 bake multiplied per channel in linear space (unit lab colour check against SECTOID.PCK facings 3 / 7 under the game lighting)",
        "linear_multipliers_rgb": [
          0.647,
          0.592,
          0.553
        ],
        "palette_base_before": "#8a6c64",
        "palette_base_after": "#71544b"
      },
      "source_assumptions": [
        "Proportions from UP024 row measurements; battlescape PCK is the silhouette/colour authority.",
        "Skin colour = battlescape mauve-brown (PCK mid-tones), recalibrated so it reads as the PCK under the game lighting.",
        "Three digits (two fingers + thumb), three toes; arms shortened so fingertips hang at mid-thigh (user decisions).",
        "Unseen sides inferred from the 8 facings and UP024; no back view exists in UP024.",
        "Idle and Hit are authored (routine 0 has no idle or hit frames).",
        "Armed: rarm1H 232 forearm-forward waist hold in IdleArmed / WalkArmed; Attack raises it to a shoulder aim (user rule).",
        "Walk: 8 sprite phases per gait cycle; the legs cover 2/3 m per cycle, so 3 cycles per straight tile.",
        "Death: crumple lead-in (264-265, knees and hips fold, sits back) hands off to the ragdoll; DeathBaked keeps a no-physics fall as fallback."
      ],
