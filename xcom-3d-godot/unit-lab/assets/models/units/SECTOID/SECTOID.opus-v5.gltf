          },
          "variant_rule": "shot travel direction t in the unit frame (x = unit right, y = unit forward; glTF/Godot: x right, -z forward): t.y <= -0.707 -> Front (shot from the front), t.y >= 0.707 -> Back, else t.x > 0 -> Left (shot from the unit's left), else Right. Play Death<variant>, hand off on its last frame with that variant's velocities. \"Death\" is a copy of DeathFront.",
          "extra_push": {
            "bone": "spine_03",
            "bones": [
              "spine_02",
              "spine_03",
              "head"
            ],
            "delta_v_mps_unit_local": [
              0.0,
              0.0,
              0.3
            ],
            "direction": "SHOT TRAVEL DIRECTION: apply delta_v (as impulse = delta_v x body mass) to every body in \"bones\" along the horizontal travel direction of the killing shot (shooter -> unit, world space), whatever the facing; the vector here only carries the magnitude"
          },
          "variation": {
            "push_yaw_jitter_deg": 12.0,
            "spin_jitter_radps": 0.3,
            "spin_bone": "spine_03",
            "note": "per death: rotate the push direction about the vertical by a uniform random angle in [-jitter, +jitter] and add a random vertical-axis spin of up to spin_jitter to spin_bone, so corpses differ; 0 disables"
          },
          "ground_clearance_lift_m": 0.002,
          "ground_clearance_rule": "at the hand-off, if any collision shape is below the walking plane, lift all bodies by that depth + 2 mm before releasing them (a depenetration launch is worse)",
          "turn_to_attacker": null,
          "no_turn": "user decision 2026-10-02: no animated turn toward the attacker; the variant and the push handle the fall direction and the twist below turns the upper body toward the shooter as physics",
          "twist_toward_shooter": {
            "max_delta_angular_velocity_radps": 7.5,
            "bodies": "all (every PhysicalBone3D, legs included)",
            "axis": "world up (Godot +Y)",
            "pivot": "mass centre of all bodies at the hand-off (horizontal position)",
            "scale": "angle between the unit facing and the direction from the unit to the shooter / 180 deg: 0 for a frontal shot, 0.5 from the side, 1 from directly behind",
            "sign": "toward the shooter: counter-clockwise seen from above (+Y) when the shooter is on the unit's left; from directly behind (within 1 deg) pick the side at random per death",
            "apply": "at the hand-off, after the variant velocities and the push: w = up x (max x scale x sign); for EVERY body: angular_velocity += w; linear_velocity += w.cross(body_centre - pivot) with body_centre and pivot taken in the horizontal plane (a rigid rotation of the whole unit, so the joints are not strained and the push momentum is unchanged)",
            "intent": "he tries to turn round too late while still being pushed away from the attack (user 2026-10-02)"
          },
          "fall_direction": "away from the shooter (along the shot travel direction)"
        },
        "settle_and_freeze": {
          "linear_speed_mps": 0.05,
          "angular_speed_radps": 0.25,
          "hold_s": 0.3,
          "time_cap_s": 3.0,
          "assist": {
            "after_s": 1.0,
            "below_mps": 0.5,
            "linear_damp": 1.0,
            "angular_damp": 4.0,
            "rule": "once the fall is over (simulation time >= after_s and every body slower than below_mps), raise the damping of every body to at least these values (Godot DAMP_MODE_REPLACE) so the residual contact jitter of the light limbs dies out (lab s3: an arm pinned between torso and floor kept rolling at ~1 rad/s into the 3 s cap); the Blender drop tests run without it"
          },
          "assist_late": {
            "after_s": 2.0,
            "below_mps": 0.3,
            "linear_damp": 6.0,
            "angular_damp": 16.0,
            "rule": "shared runtime contract (root 2026-10-02): after the first assist, once simulation time >= after_s and every body is slower than below_mps (the corpse only creeps), raise every body's damping to at least these values so a slow topple or limb creep ends before the time cap"
          },
          "action": "freeze: copy the simulated bone poses into the Skeleton3D pose and stop the simulation (static corpse)"
        },
